# --- Required ---
OWNER_COUNTRY=KY               # required: ISO 3166-1 alpha-2 country of residence (P-04)
METACULUS_API_TOKEN=           # required for the Metaculus collector (P-06); other venues work without it

# --- Optional: Kalshi (public market-data endpoints need no key) ---
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2   # optional override; verify against docs.kalshi.com
KALSHI_API_KEY_ID=             # optional: key id, only for endpoints that reject unauthenticated GETs (P-05)
KALSHI_PRIVATE_KEY_PATH=       # optional: absolute path to the PEM private key, outside the repo

# --- Optional: Polymarket on-chain history ---
DUNE_API_KEY=                  # optional: Dune free tier (P-07)
POLYMARKET_SUBGRAPH_URL=       # optional: subgraph endpoint, fallback to Dune (P-08)
THEGRAPH_API_KEY=              # optional: only if the subgraph is served through The Graph gateway

# --- Optional: local paths and runtime ---
DATA_ROOT=~/data/prediction-market-research    # data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader); native Windows test runs: leave empty (~ would point to C:)
PMR_DATA_DIR=                                  # optional: root of raw/, interim/, processed/; empty = DATA_ROOT, or ./data when DATA_ROOT is empty
PMR_WAREHOUSE_PATH=                            # optional: the single DuckDB warehouse file; empty = <data root>/warehouse.duckdb
PMR_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # optional: local embedding model (D-07)
HF_HOME=                       # optional: Hugging Face cache directory
PMR_USER_AGENT=prediction-market-research/0.1 (+https://github.com/avmhdt/prediction-market-research)  # optional
PMR_LOG_LEVEL=INFO             # optional: DEBUG | INFO | WARNING
